{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ruckcode",
  "version": "0.1.0",
  "identifier": "dev.ruckcode.app",
  "build": {
    "frontendDist": "../../app/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../../app" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../../app" }
  },
  "app": {
    "windows": [
      { "label": "main", "title": "ruckcode", "width": 1100, "height": 760, "minWidth": 640, "minHeight": 420 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
